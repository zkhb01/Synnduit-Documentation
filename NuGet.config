<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local NuGet config. The machine-level config (%APPDATA%\NuGet\NuGet.Config) enforces a
  curated PackageSourceMapping allow-list that does not include the Anthropic SDK. NuGet uses the
  nearest packageSourceMapping section, so this file REPLACES that section for this repo. It keeps
  the same curated spirit — every package is still explicitly mapped to a source — while adding the
  one new dependency this project needs: Anthropic (the official Claude .NET SDK, used by
  SynnduitTutor's ClaudeRemediationService).
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- New dependency for this repo -->
      <package pattern="Anthropic" />

      <!-- App + test dependencies already used by this solution -->
      <package pattern="Markdig" />
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <package pattern="Std.UriTemplate" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="NETStandard.Library" />
      <package pattern="SQLitePCLRaw.bundle_e_sqlite3" />
      <package pattern="SQLitePCLRaw.core" />
      <package pattern="SQLitePCLRaw.lib.e_sqlite3" />
      <package pattern="SQLitePCLRaw.provider.e_sqlite3" />
      <package pattern="bunit" />
      <package pattern="bunit.core" />
      <package pattern="bunit.web" />
      <package pattern="AngleSharp" />
      <package pattern="AngleSharp.Css" />
      <package pattern="AngleSharp.Diffing" />
      <package pattern="coverlet.collector" />
      <package pattern="xunit" />
      <package pattern="xunit.abstractions" />
      <package pattern="xunit.analyzers" />
      <package pattern="xunit.assert" />
      <package pattern="xunit.core" />
      <package pattern="xunit.extensibility.core" />
      <package pattern="xunit.extensibility.execution" />
      <package pattern="xunit.runner.visualstudio" />
    </packageSource>
  </packageSourceMapping>
</configuration>
