@implements IDisposable
@inject LearnerSession Session
@inject IConfiguration Config
@inject MasteryService Mastery

<div class="brand">
    <a class="brand-lockup" href="">
        <span class="crest"><img src="brand/ccsd-mark.png" alt="Calgary Catholic School District" /></span>
        <span class="wordmark">
            <span class="wm-1">Synnduit</span>
            <span class="wm-2">Tutor</span>
        </span>
    </a>
    <div class="brand-sub">Integration learning path</div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">@(Session.IsSignedIn ? "All courses" : "Sign in")</NavLink>
        </div>
    </nav>

    @if (Session.IsSignedIn)
    {
        <div class="learner-chip">
            <span class="lc-label">Signed in</span>
            <span class="lc-name">
                @Session.DisplayName
                @if (Session.IsAuditor)
                {
                    <span class="badge bg-secondary ms-1" title="Audit mode — viewing all lessons, quizzes disabled">audit</span>
                }
            </span>
        </div>

        <div class="nav-item audit-toggle">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="auditSwitch"
                       checked="@Session.IsAuditor" @onchange="ToggleAuditAsync" />
                <label class="form-check-label" for="auditSwitch" title="View all lessons without taking quizzes">
                    Audit mode
                </label>
            </div>
        </div>

        @if (Config.IsEntraConfigured())
        {
            <div class="nav-item">
                <a class="nav-link" href="auth/logout">Sign out</a>
            </div>
        }
    }
</div>

@code {
    // The sidebar must re-render when the session changes (sign-in happens after the nav first renders,
    // and the audit toggle flips state), otherwise the learner chip and toggle never appear.
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    public void Dispose() => Session.Changed -= OnSessionChanged;

    private async void OnSessionChanged() => await InvokeAsync(StateHasChanged);

    private async Task ToggleAuditAsync(ChangeEventArgs e)
    {
        if (!Session.IsSignedIn) return;
        var on = (bool)e.Value!;
        await Mastery.SetAuditorAsync(Session.LearnerId!.Value, on);
        // Raises LearnerSession.Changed → the dashboard reloads its gating overview with the new mode.
        Session.SetAuditor(on);
    }
}
