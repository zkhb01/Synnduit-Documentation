@page "/{Course}/quiz/{ConceptId}"
@inject CourseCatalog Catalog
@inject LearnerSession Session
@inject MasteryService Mastery
@inject ScoringService Scoring
@inject IAnswerGrader Grader
@inject IRemediationService Remediation
@inject NavigationManager Nav

<PageTitle>Quiz: @(_concept?.Name ?? ConceptId) — Synnduit Tutor</PageTitle>

@if (_store is null)
{
    <p class="text-danger">Unknown course <code>@Course</code>.</p>
    <a href="">← All courses</a>
}
else if (!Session.IsSignedIn)
{
    <RedirectToHome />
}
else if (_concept is null)
{
    <p class="text-danger">Concept <code>@ConceptId</code> not found.</p>
    <a href="@($"{Course}/dashboard")">← My path</a>
}
else
{
    <div class="mb-2"><a href="@($"{Course}/lesson/{_concept.Id}")" class="text-decoration-none">← Lesson</a></div>
    <h2>Check: @_concept.Id — @_concept.Name</h2>
    <p class="text-muted">Pass mark: @((int)(_concept.MasteryThreshold * 100))%. @_items.Count question(s).</p>

    @if (_result is null)
    {
        @for (var qi = 0; qi < _items.Count; qi++)
        {
            var item = _items[qi];
            var n = qi + 1;
            <div class="card mb-3">
                <div class="card-body">
                    <p><strong>@n.</strong> @item.Stem
                        <span class="badge bg-light text-dark ms-1">@item.Difficulty</span>
                        @if (!item.IsAutoScored) { <span class="badge bg-info text-dark">practice · @(Grader.IsLive ? "Claude feedback" : "self-check")</span> }
                    </p>

                    @switch (item.Type)
                    {
                        case "mc":
                            @foreach (var o in item.Options!)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="@item.Id"
                                           id="@(item.Id)_@o.Id" checked="@(_single.GetValueOrDefault(item.Id) == o.Id)"
                                           @onchange="() => _single[item.Id] = o.Id" />
                                    <label class="form-check-label" for="@(item.Id)_@o.Id">@o.Text</label>
                                </div>
                            }
                            break;

                        case "multi":
                            @foreach (var o in item.Options!)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           id="@(item.Id)_@o.Id" checked="@(_multi.GetValueOrDefault(item.Id)?.Contains(o.Id) ?? false)"
                                           @onchange="e => ToggleMulti(item.Id, o.Id, (bool)e.Value!)" />
                                    <label class="form-check-label" for="@(item.Id)_@o.Id">@o.Text</label>
                                </div>
                            }
                            break;

                        case "order":
                            <p class="small text-muted mb-1">Assign each line its position (1 = first).</p>
                            @foreach (var o in item.Options!)
                            {
                                <div class="d-flex align-items-center mb-1">
                                    <select class="form-select form-select-sm me-2" style="width:5rem"
                                            @onchange="e => SetRank(item.Id, o.Id, e.Value?.ToString())">
                                        <option value="">–</option>
                                        @for (var r = 1; r <= item.Options!.Count; r++)
                                        {
                                            <option value="@r" selected="@(_ranks.GetValueOrDefault(item.Id)?.GetValueOrDefault(o.Id) == r)">@r</option>
                                        }
                                    </select>
                                    <span>@o.Text</span>
                                </div>
                            }
                            break;

                        default: // short / scenario / classify / match — model-graded
                            <textarea class="form-control mb-2" rows="3" placeholder="Your answer…"
                                      @bind="_text[item.Id]"></textarea>
                            @if (Grader.IsLive)
                            {
                                <p class="small text-muted mb-0">Your answer will be graded against the rubric.</p>
                            }
                            else
                            {
                                <details class="mb-2">
                                    <summary class="small">Show sample answer &amp; rubric</summary>
                                    @if (item.SampleAnswer is not null)
                                    {
                                        @if (CodeHighlighter.LooksLikeCode(item.SampleAnswer))
                                        {
                                            <pre class="vscode mt-2 mb-1"><code>@CodeHighlighter.Highlight(item.SampleAnswer)</code></pre>
                                        }
                                        else
                                        {
                                            <p class="mt-2 mb-1"><em>@item.SampleAnswer</em></p>
                                        }
                                    }
                                    @if (item.Rubric is { Count: > 0 })
                                    {
                                        <ul class="small mb-0">@foreach (var r in item.Rubric) { <li>@r</li> }</ul>
                                    }
                                </details>
                                <div class="btn-group btn-group-sm" role="group">
                                    <input type="radio" class="btn-check" name="@(item.Id)_self" id="@(item.Id)_yes"
                                           checked="@(_self.GetValueOrDefault(item.Id) == true)"
                                           @onchange="() => _self[item.Id] = true" />
                                    <label class="btn btn-outline-success" for="@(item.Id)_yes">I covered the rubric</label>
                                    <input type="radio" class="btn-check" name="@(item.Id)_self" id="@(item.Id)_no"
                                           checked="@(_self.GetValueOrDefault(item.Id) == false)"
                                           @onchange="() => _self[item.Id] = false" />
                                    <label class="btn btn-outline-secondary" for="@(item.Id)_no">Not quite</label>
                                </div>
                            }
                            break;
                    }
                </div>
            </div>
        }

        <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@_submitting">@(_submitting ? "Grading…" : "Submit answers")</button>
    }
    else
    {
        <div class="alert @(_result.Passed ? "alert-success" : "alert-warning")">
            <h4 class="mb-1">@((int)Math.Round(_result.Score * 100))% — @(_result.Passed ? "Mastered! ✔" : "Not yet")</h4>
            @{
                var gradedItems = _result.Items.Where(r => !r.WasModelScored).ToList();
                var practiceCount = _result.Items.Count - gradedItems.Count;
            }
            <div>@gradedItems.Count(r => r.Correct) of @gradedItems.Count graded questions correct (pass @((int)(_concept.MasteryThreshold * 100))%).</div>
            @if (practiceCount > 0)
            {
                <div class="small mt-1">@practiceCount open-ended @(practiceCount == 1 ? "question is" : "questions are") practice — they show feedback below but don't count toward your score.</div>
            }
            @if (_escalated)
            {
                <div class="mt-2"><strong>Heads up:</strong> after repeated attempts, this concept is flagged for a mentor (@_store!.Graph.MasteryModel.EscalationTarget).</div>
            }
        </div>

        @if (_awards.Count > 0)
        {
            <div class="donut-earned">
                <div class="de-donuts">
                    @for (var i = 0; i < _awards.Sum(a => a.Points); i++) { <Donut Size="40" /> }
                </div>
                <div class="de-body">
                    <div class="de-total">+@(_awards.Sum(a => a.Points)) donuts earned</div>
                    <ul class="de-reasons">
                        @foreach (var a in _awards)
                        {
                            <li><span class="de-pts">+@a.Points</span> @AwardLabel(a.Reason)</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (_levelJustCompleted)
        {
            <div class="milestone-banner">
                <div class="mb-cross">✠</div>
                <div>
                    <div class="eyebrow">Milestone</div>
                    <h3 class="mb-1">@_completedLevelName — gate cleared</h3>
                    <p class="mb-2">Every concept in this level is mastered. Head to your path to redeem your donut voucher.</p>
                    <a class="btn btn-primary btn-sm" href="@($"{Course}/dashboard")">Go to my path →</a>
                </div>
            </div>
        }

        @foreach (var r in _result.Items)
        {
            <div class="card mb-2 border-@(r.Correct ? "success" : "danger")">
                <div class="card-body py-2">
                    <div>@(r.Correct ? "✔" : "✗") <strong>@r.Item.Stem</strong>
                        @if (r.WasModelScored) { <span class="badge bg-info text-dark">practice · @(Grader.IsLive ? "Claude feedback" : "self-check")</span> }
                    </div>
                    @if (_grades.TryGetValue(r.Item.Id, out var g))
                    {
                        <div class="small mt-1">@g.Feedback</div>
                        @if (g.Missed.Count > 0)
                        {
                            <div class="small text-muted mt-1">Missing: @string.Join("; ", g.Missed)</div>
                        }
                    }
                    @if (!string.IsNullOrEmpty(r.Item.Explanation))
                    {
                        <div class="small text-muted mt-1">@r.Item.Explanation</div>
                    }
                </div>
            </div>
        }

        @if (_remediation is not null)
        {
            <div class="card border-warning mt-3">
                <div class="card-header bg-warning-subtle">
                    @_remediation.Heading
                    <span class="badge bg-secondary ms-2">@(_remediation.IsLive ? "Claude" : "guided")</span>
                </div>
                <div class="card-body">
                    <p>@_remediation.Body</p>
                    @if (_remediation.MisconceptionNotes.Count > 0)
                    {
                        <p class="mb-1"><strong>About the answers you picked:</strong></p>
                        <ul>@foreach (var note in _remediation.MisconceptionNotes) { <li>@note</li> }</ul>
                    }
                </div>
            </div>
        }

        <div class="mt-3 d-flex gap-2">
            <a class="btn btn-outline-secondary" href="@($"{Course}/dashboard")">← My path</a>
            @if (!_result.Passed)
            {
                <a class="btn btn-primary" href="@($"{Course}/lesson/{_concept.Id}")">Re-read lesson</a>
                <button class="btn btn-outline-primary" @onclick="Retry">Try fresh questions</button>
            }
        </div>
    }
}

@code {
    [Parameter] public string Course { get; set; } = "";
    [Parameter] public string ConceptId { get; set; } = "";

    private CurriculumStore? _store;
    private Concept? _concept;
    private List<Item> _items = new();
    private bool _submitting;
    private bool _escalated;

    private readonly Dictionary<string, string> _single = new();
    private readonly Dictionary<string, HashSet<string>> _multi = new();
    private readonly Dictionary<string, Dictionary<string, int>> _ranks = new();
    private readonly Dictionary<string, string> _text = new();
    private readonly Dictionary<string, bool?> _self = new();
    private readonly Dictionary<string, GradeResult> _grades = new();

    private QuizResult? _result;
    private RemediationResult? _remediation;
    private IReadOnlyList<DonutAward> _awards = Array.Empty<DonutAward>();
    private bool _levelJustCompleted;
    private string? _completedLevelName;

    protected override async Task OnParametersSetAsync()
    {
        _store = Catalog.GetStore(Course);
        if (_store is null || !Session.IsSignedIn) return;   // markup handles unknown course / redirect
        _concept = _store.Graph.FindConcept(ConceptId);
        if (_concept is null) return;
        await LoadItemsAsync();
    }

    private async Task LoadItemsAsync()
    {
        var m = await Mastery.GetMasteryAsync(Session.LearnerId!.Value, Course, _concept!.Id);
        var seen = new HashSet<string>((m?.SeenItemIdsCsv ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        _items = _store!.SelectItems(_concept.ItemPoolId, seen, 5);
        ResetInputs();
        // Seed text entries so the two-way @bind getter on model-item textareas never indexes a missing key.
        foreach (var it in _items)
            _text[it.Id] = "";
    }

    private void ResetInputs()
    {
        _single.Clear(); _multi.Clear(); _ranks.Clear(); _text.Clear(); _self.Clear(); _grades.Clear();
        _result = null; _remediation = null; _escalated = false;
        _awards = Array.Empty<DonutAward>(); _levelJustCompleted = false; _completedLevelName = null;
    }

    private void ToggleMulti(string itemId, string optId, bool on)
    {
        var set = _multi.TryGetValue(itemId, out var s) ? s : _multi[itemId] = new();
        if (on) set.Add(optId); else set.Remove(optId);
    }

    private void SetRank(string itemId, string optId, string? value)
    {
        var map = _ranks.TryGetValue(itemId, out var m) ? m : _ranks[itemId] = new();
        if (int.TryParse(value, out var r)) map[optId] = r; else map.Remove(optId);
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        var responses = new Dictionary<string, ItemResponse>();
        foreach (var item in _items)
        {
            var resp = new ItemResponse();
            switch (item.Type)
            {
                case "mc":
                    if (_single.TryGetValue(item.Id, out var one)) resp.SelectedOptionIds.Add(one);
                    break;
                case "multi":
                    if (_multi.TryGetValue(item.Id, out var set)) resp.SelectedOptionIds.AddRange(set);
                    break;
                case "order":
                    if (_ranks.TryGetValue(item.Id, out var ranks))
                        resp.OrderedOptionIds = ranks.OrderBy(kv => kv.Value).Select(kv => kv.Key).ToList();
                    break;
                default: // model-scored: short / scenario / classify / match
                    var answer = _text.GetValueOrDefault(item.Id) ?? "";
                    resp.FreeText = answer;
                    if (Grader.IsLive)
                    {
                        var grade = await Grader.GradeAsync(item, answer);
                        _grades[item.Id] = grade;
                        resp.SelfAssessedCorrect = grade.Correct;
                    }
                    else
                    {
                        resp.SelfAssessedCorrect = _self.GetValueOrDefault(item.Id);
                    }
                    break;
            }
            responses[item.Id] = resp;
        }

        _result = Scoring.Score(_items, responses, _concept!.MasteryThreshold);
        var outcome = await Mastery.RecordAttemptAsync(
            Session.LearnerId!.Value, Course, _concept, _result, _items.Select(i => i.Id));
        _escalated = outcome.Mastery.EscalatedToMentor;
        _awards = outcome.NewAwards;
        _levelJustCompleted = outcome.LevelJustCompleted;
        _completedLevelName = outcome.CompletedLevelName;

        if (!_result.Passed)
        {
            var lesson = _store!.GetLesson(_concept.Id);
            _remediation = await Remediation.RemediateAsync(_concept, lesson, _result.WrongItems, responses);
        }

        _submitting = false;
    }

    private static string AwardLabel(string reason) => reason switch
    {
        "Mastered" => "Concept mastered",
        "FirstAttempt" => "First-attempt bonus",
        "Perfect" => "Perfect score",
        "Critical" => "Critical concept",
        "LevelComplete" => "Level cleared",
        _ => reason
    };

    private async Task Retry()
    {
        await LoadItemsAsync();
    }
}
