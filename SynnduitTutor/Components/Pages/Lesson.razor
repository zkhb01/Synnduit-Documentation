@page "/lesson/{ConceptId}"
@rendermode InteractiveServer
@inject CurriculumStore Store
@inject LearnerSession Session

<PageTitle>@(_concept?.Name ?? ConceptId) — Synnduit Tutor</PageTitle>

@if (!Session.IsSignedIn)
{
    <RedirectToHome />
}
else if (_concept is null)
{
    <p class="text-danger">Concept <code>@ConceptId</code> was not found.</p>
    <a href="/dashboard">← Back to my path</a>
}
else
{
    <div class="mb-3">
        <a href="/dashboard" class="text-decoration-none">← My path</a>
    </div>

    @if (_lesson is not null)
    {
        <article class="lesson">
            @((MarkupString)_lesson.HtmlBody)
        </article>
    }
    else
    {
        <h1>@_concept.Id — @_concept.Name</h1>
        <p class="text-muted">No authored lesson found; here is the objective.</p>
        <blockquote class="blockquote"><p>@_concept.DisplayObjective</p></blockquote>
    }

    <hr />
    <div class="d-flex justify-content-between align-items-center">
        <small class="text-muted">
            @if (_lesson?.Get("sources") is { Length: > 0 } src) { <span>Sources: @src</span> }
        </small>
        <a class="btn btn-primary" href="@($"/quiz/{_concept.Id}")">Check my understanding →</a>
    </div>
}

@code {
    [Parameter] public string ConceptId { get; set; } = "";

    private Concept? _concept;
    private Models.Lesson? _lesson;

    protected override void OnParametersSet()
    {
        _concept = Store.Graph.FindConcept(ConceptId);
        _lesson = _concept is null ? null : Store.GetLesson(ConceptId);
    }
}
