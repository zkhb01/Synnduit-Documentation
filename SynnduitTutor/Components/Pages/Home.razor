@page "/"
@inject MasteryService Mastery
@inject LearnerSession Session
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>Synnduit Tutor — Sign in</PageTitle>

<div class="hero">
    <div class="eyebrow">Calgary Catholic · Integration Team</div>
    <h1>Synnduit Tutor</h1>
    <p class="lead">Learn how Synnduit works, one concept at a time. Master the foundations,
    then prove your .NET prerequisites — guided, gated, and grounded in our own docs.</p>
</div>

@if (_entra)
{
    <hr class="my-4" />
    <div class="eyebrow mb-3">Begin</div>
    <p class="text-muted">Sign in with your Calgary Catholic account to start your learning path.</p>
    <a class="btn btn-primary" href="/auth/login">Sign in with Microsoft</a>
}
else
{
    <div class="alert alert-secondary py-2">
        <small><strong>Core preview:</strong> authentication is stubbed — pick or create a learner below.
        Configure the <code>AzureAd</code> section to switch on Entra SSO.</small>
    </div>

    <hr class="my-4" />
    <div class="eyebrow mb-3">Begin</div>

    <div class="row">
        <div class="col-md-6">
            <h4>Continue as</h4>
            @if (_learners is null)
            {
                <p><em>Loading…</em></p>
            }
            else if (_learners.Count == 0)
            {
                <p class="text-muted">No learners yet — create one on the right.</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var l in _learners)
                    {
                        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                @onclick="() => SignIn(l)">
                            <span>@l.DisplayName</span>
                            <small class="text-muted">@l.ExternalId</small>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="col-md-6">
            <h4>New learner</h4>
            <div class="mb-2">
                <label class="form-label">Display name</label>
                <input class="form-control" @bind="_newName" @bind:event="oninput" placeholder="e.g. Eason Zhang" />
            </div>
            <button class="btn btn-primary" @onclick="CreateAsync" disabled="@string.IsNullOrWhiteSpace(_newName)">
                Create &amp; start
            </button>
        </div>
    </div>
}

@code {
    private List<Learner>? _learners;
    private string _newName = "";
    private bool _entra;

    protected override async Task OnInitializedAsync()
    {
        _entra = Config.IsEntraConfigured();
        if (!_entra) _learners = await Mastery.GetLearnersAsync();
    }

    private void SignIn(Learner l)
    {
        Session.SignIn(l.Id, l.DisplayName);
        Nav.NavigateTo("/dashboard");
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        var ext = "stub:" + _newName.Trim().ToLowerInvariant().Replace(' ', '.');
        var learner = await Mastery.GetOrCreateLearnerAsync(_newName.Trim(), ext);
        SignIn(learner);
    }
}
